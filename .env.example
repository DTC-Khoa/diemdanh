# ==============================================================
# HỆ THỐNG ĐIỂM DANH DTC-KHOA - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sao chép file này thành .env trước khi khởi chạy hệ thống:
# cp .env.example .env
# ==============================================================

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=attendance_db
DB_USER=root
DB_ROOT_PASSWORD=rootpassword
DB_PASSWORD=rootpassword

# Cấu hình Ứng dụng Web Node.js
PORT=3000
NODE_ENV=production
SESSION_SECRET=attendance_dtc_super_secret_session_key_2026

# Cấu hình Quản trị Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
